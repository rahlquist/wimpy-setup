[Unit]
Description=llama.cpp nightly model benchmark sweep (both GPUs)
After=network.target

[Service]
Type=oneshot
Environment=TZ=America/New_York
# Fail loudly if either bench binary is gone (2026-07-08: unit silently pointed
# at a deleted build tree for a night — never exit 0 with nothing benched).
ExecStartPre=/usr/bin/test -x /usr/local/bin/llama-bench
ExecStartPre=/usr/bin/test -x /opt/llama-cuda/bin/llama-bench
# Drive the sweep across both GPUs (R9700 ROCm + RTX 5060 Ti CUDA) via the
# wrapper; the wrapper also regenerates bench_results.html.
ExecStart=/bin/bash -o pipefail -c '/home/rahlquist/wimpy-setup/benching/run-nightly-bench.sh'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-bench-nightly
