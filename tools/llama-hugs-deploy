#!/usr/bin/env bash
# User-owned Llama Hugs config deployer; no sudo or root-owned files required.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE_CONFIG="${SOURCE_CONFIG:-$(cd "$SCRIPT_DIR/.." && pwd)/llama-hugs-config.yaml}"
RUNTIME_CONFIG="$HOME/.config/llama-hugs/config.yaml"
GEN_CONFIG=/opt/llama-hugs/gen-config.py
API_URL="${HUGS_API_URL:-http://127.0.0.1:8080/v1/models}"
SERVICE=llama-hugs.service
RELOAD_TIMEOUT=60

err() { printf '[ERR] %s\n' "$*" >&2; }
ok() { printf '[OK]  %s\n' "$*"; }
die() { err "$*"; exit 1; }

# gen-config.py and the validation blocks below import yaml. A bare `python3`
# on PATH may be a toolchain interpreter (e.g. ~/.hermes/tools/...) that has no
# PyYAML, which made every deploy die with ModuleNotFoundError. Pin the system
# interpreter, which is the one that has yaml installed.
PYTHON_BIN="${PYTHON_BIN:-}"
if [[ -z "$PYTHON_BIN" ]]; then
  for candidate in /usr/bin/python3 python3; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import yaml' >/dev/null 2>&1; then
      PYTHON_BIN="$(command -v "$candidate")"
      break
    fi
  done
fi
[[ -n "$PYTHON_BIN" ]] || die 'no python3 with PyYAML found; install PyYAML or set PYTHON_BIN'

[[ "${EUID:-$(id -u)}" -ne 0 ]] || die 'run as rahlquist, not root'
[[ -f "$SOURCE_CONFIG" ]] || die "source config missing: $SOURCE_CONFIG"
[[ -x "$GEN_CONFIG" ]] || die "config generator missing or not executable: $GEN_CONFIG"
[[ -f "$HOME/.config/systemd/user/$SERVICE" ]] || die "user unit missing: $HOME/.config/systemd/user/$SERVICE (run ./install-llama-hugs-autodeploy.sh once)"
command -v systemctl >/dev/null || die 'systemctl missing'
command -v curl >/dev/null || die 'curl missing'
command -v "$PYTHON_BIN" >/dev/null || die "python3 missing: $PYTHON_BIN"

runtime_dir="$(dirname "$RUNTIME_CONFIG")"
mkdir -p -- "$runtime_dir"
tmp="$(mktemp "$runtime_dir/.config.generated.XXXXXX")"
api_tmp="$(mktemp /tmp/llama-hugs-user-deploy-api.XXXXXX)"
api_err="${api_tmp}.err"
backup=''
cleanup() { rm -f -- "$tmp" "$api_tmp" "$api_err"; }
trap cleanup EXIT INT TERM

install_runtime_config() {
  local source="$1" staged
  staged="$(mktemp "$runtime_dir/.config.stage.XXXXXX")"
  install -m 0644 -- "$source" "$staged"
  mv -f -- "$staged" "$RUNTIME_CONFIG"
}

restore_runtime_config() {
  if [[ -n "$backup" && -f "$backup" ]]; then
    err "restoring prior user config: $backup"
    install_runtime_config "$backup"
    systemctl --user restart "$SERVICE" || return 1
    ok 'restored prior user config and restarted the user service'
  else
    err 'no previous user config exists; removing the failed candidate'
    rm -f -- "$RUNTIME_CONFIG"
    systemctl --user stop "$SERVICE" || true
  fi
}

api_matches_config() {
  local config="$1" api_json="$2"
  "$PYTHON_BIN" - "$config" "$api_json" <<'PY'
import json
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as stream:
    config = yaml.safe_load(stream)
models = config.get("models") if isinstance(config, dict) else None
if not isinstance(models, dict) or not models:
    raise SystemExit("generated config has no models mapping")
with open(sys.argv[2], encoding="utf-8") as stream:
    payload = json.load(stream)

# llama-hugs (post-2026-09 rebuild) serves each model under a GPU-scoped picker
# ID ("lr-" for ROCm/amd-r9700, "lc-" for CUDA/nvidia-5060ti), NOT under the
# "hugs-" key from the config. Comparing config keys against "id" therefore
# never matches and every deploy falsely rolls back. The mapping back to the
# config key is published as meta.llamaswap.legacy_id, so match on that.
present = set()
for row in payload.get("data", []):
    if not isinstance(row, dict):
        continue
    model_id = row.get("id")
    if isinstance(model_id, str):
        present.add(model_id)
    meta = row.get("meta")
    if isinstance(meta, dict):
        llswap = meta.get("llamaswap")
        if isinstance(llswap, dict):
            legacy = llswap.get("legacy_id")
            if isinstance(legacy, str):
                present.add(legacy)
            for alias in llswap.get("aliases") or []:
                if isinstance(alias, str):
                    present.add(alias)

missing = sorted(set(models) - present)
if missing:
    raise SystemExit("API missing generated model IDs: " + ", ".join(missing))
print(f"validated API model list: {len(models)} models")
PY
}

# Produce and validate the generated runtime config before touching the active file.
# Run gen-config.py through the pinned interpreter rather than its
# `#!/usr/bin/env python3` shebang, which can resolve to a toolchain python
# without PyYAML.
SOURCE_CONFIG="$SOURCE_CONFIG" DEST_CONFIG="$tmp" "$PYTHON_BIN" "$GEN_CONFIG"
"$PYTHON_BIN" - "$tmp" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as stream:
    data = yaml.safe_load(stream)
models = data.get("models") if isinstance(data, dict) else None
if not isinstance(models, dict) or not models:
    raise SystemExit("generated config has no models mapping")
for model_id, entry in models.items():
    if not isinstance(model_id, str) or not model_id.startswith("hugs-"):
        raise SystemExit(f"generated model ID is not hugs-prefixed: {model_id!r}")
    if not isinstance(entry, dict) or not isinstance(entry.get("cmd"), str) or not entry["cmd"].strip():
        raise SystemExit(f"generated model has no cmd: {model_id}")
print(f"validated generated config: {len(models)} models")
PY

if [[ -f "$RUNTIME_CONFIG" ]]; then
  backup="$(mktemp "${RUNTIME_CONFIG}.bak.$(date +%Y%m%d%H%M%S).XXXXXX")"
  cp -p -- "$RUNTIME_CONFIG" "$backup"
fi
install_runtime_config "$tmp"
ok "installed user runtime config: $RUNTIME_CONFIG"

if systemctl --user is-active --quiet "$SERVICE"; then
  systemctl --user restart "$SERVICE"
else
  systemctl --user start "$SERVICE"
fi

last_error='no successful API validation'
for ((i=1; i<=RELOAD_TIMEOUT; i++)); do
  if curl -fsS --max-time 5 "$API_URL" >"$api_tmp" 2>"$api_err"; then
    if api_matches_config "$tmp" "$api_tmp" >"$api_err" 2>&1; then
      ok 'user Llama Hugs service is active and API matches generated config'
      [[ -z "$backup" ]] || ok "backup retained: $backup"
      exit 0
    fi
    last_error="$(tr '\n' ' ' < "$api_err")"
  else
    last_error='Llama Hugs API not reachable'
  fi
  sleep 1
done

err "user service validation failed after ${RELOAD_TIMEOUT}s: $last_error"
restore_runtime_config || true
die 'user deployment rolled back'
