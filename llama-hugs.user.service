[Unit]
Description=llama-hugs model router (rahlquist user service)

[Service]
Type=simple
WorkingDirectory=/
ExecStart=/opt/llama-hugs/llama-hugs --config %h/.config/llama-hugs/config.yaml -watch-config
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
