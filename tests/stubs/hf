#!/usr/bin/env bash
# Fake `hf` CLI for test harness.
# Accepts: download <repo_id> <file> --local-dir <dir>
# Copies tests/fixtures/${HF_STUB_FIXTURE:-tiny}.gguf to <dir>/<file>
# Exits 1 if HF_STUB_FAIL=1
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")/../fixtures" && pwd)"
LOG="${HF_STUB_LOG:-/dev/null}"

printf '[HF-STUB] %s\n' "$*" >> "$LOG"

if [[ "${HF_STUB_FAIL:-0}" == "1" ]]; then
  echo "[HF-STUB] FORCED FAILURE" >&2
  exit 1
fi

# Parse args: download <repo_id> <file> --local-dir <dir>
if [[ "${1:-}" != "download" ]]; then
  echo "[HF-STUB] expected 'download' as first arg, got: ${1:-}" >&2
  exit 1
fi
REPO_ID="${2:-}"
FILE="${3:-}"
DIR=""
for ((i=4; i<=$#; i++)); do
  if [[ "${!i}" == "--local-dir" ]]; then
    n=$((i+1))
    DIR="${!n}"
    break
  fi
done
[[ -n "$DIR" ]] || { echo "[HF-STUB] missing --local-dir" >&2; exit 1; }
FIXTURE="${HF_STUB_FIXTURE:-tiny}"
SRC="$SCRIPT_DIR/${FIXTURE}.gguf"
[[ -f "$SRC" ]] || { echo "[HF-STUB] fixture not found: $SRC" >&2; exit 1; }
DEST="$DIR/$FILE"
mkdir -p "$(dirname "$DEST")"
cp "$SRC" "$DEST"
echo "[HF-STUB] copied $SRC -> $DIR/$FILE" >> "$LOG"
