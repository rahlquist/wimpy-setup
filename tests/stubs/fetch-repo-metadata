#!/usr/bin/env python3
"""Test stub for fetch_repo_metadata.py.

Mirrors tests/stubs/hf: returns metadata for the fixture repo, advertising the
REAL sha256 + size of the fixture file (HF_STUB_FIXTURE, default "tiny") so the
acquisition checksum verification passes in tests.
"""
import hashlib
import json
import os
import sys
from pathlib import Path

if len(sys.argv) < 3:
    raise SystemExit("usage: fetch_repo_metadata.py <repo_id> <base_filename>")
repo_id, base_file = sys.argv[1], sys.argv[2]

fixture = os.environ.get("HF_STUB_FIXTURE", "tiny")
fixture_path = Path(__file__).resolve().parent.parent / "fixtures" / f"{fixture}.gguf"
if not fixture_path.is_file():
    raise SystemExit(f"fixture not found: {fixture_path}")

blob = fixture_path.read_bytes()
out = {
    "repo_id": repo_id,
    "repo_url": f"https://huggingface.co/{repo_id}",
    "repo_name": repo_id.split("/")[-1],
    "pipeline_tag": "text-generation",
    "description": "",
    "file_size_bytes": len(blob),
    "file_sha256": hashlib.sha256(blob).hexdigest(),
    "has_checksum": True,
}
print(json.dumps(out, sort_keys=True))
raise SystemExit(0)
